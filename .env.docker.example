# Copy this file to .env.docker before deploying:
#   cp .env.docker.example .env.docker
#
# Do not commit .env.docker. It contains real deployment secrets.

# ---------------------------------------------------------------------------
# Docker Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=effchat
COMPOSE_PROFILES=bundled-db
DOCKER_NETWORK=effchat_net
DATA_DIR=../data
WEB_PORT=8088
BACKEND_PORT=18080
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# ---------------------------------------------------------------------------
# Docker build registries / proxy
#
# Your shell may use 127.0.0.1 for a local proxy, but build containers cannot
# reach the host through their own 127.0.0.1. Use host.docker.internal instead
# when building with OrbStack / Docker Desktop.
#
# Official registries are the portable defaults. Override these values with
# regional mirrors only when your network requires them.
# ---------------------------------------------------------------------------
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine

# Optional: pass the host proxy into Docker build.
DOCKER_BUILD_HTTP_PROXY=
DOCKER_BUILD_HTTPS_PROXY=
DOCKER_BUILD_ALL_PROXY=
# Example for OrbStack / Docker Desktop:
# DOCKER_BUILD_HTTP_PROXY=http://host.docker.internal:1082
# DOCKER_BUILD_HTTPS_PROXY=http://host.docker.internal:1082
# DOCKER_BUILD_ALL_PROXY=socks5://host.docker.internal:1082
DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1,::1

# Runtime proxy bypass base list. docker-compose appends internal service names
# such as postgres/backend/web/py-extractor so they never go through a proxy.
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# ---------------------------------------------------------------------------
# PostgreSQL 17
# ---------------------------------------------------------------------------
POSTGRES_USER=effchat
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=effchat

# Backend and migration use the same database selection. DATABASE_URL takes
# precedence when set; otherwise the split DB_* fields are used. The bundled
# profile maps DB_* to the dedicated postgres service below.
DATABASE_URL=
DB_HOST=postgres
DB_PORT=5432
DB_USER=effchat
DB_PASSWORD=change-this-postgres-password
DB_NAME=effchat
DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
SERVER_MODE=release
JWT_SECRET=your-secret-key-change-this-in-production

# Wait only for the first meaningful model output. After output starts, a valid
# stream may continue until EOF; user stop, server drain, and other semantic
# cancellation still take effect. 0 keeps the built-in chat/compaction defaults.
RUN_FIRST_OUTPUT_TIMEOUT=0
SSE_HEARTBEAT_INTERVAL=12s

# Auth throttling. This is process-local and intended for small self-hosted use.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_BLOCK_SECONDS=900

# Document extraction sidecar. The service is internal-only in docker-compose.
PY_EXTRACTOR_ENABLED=true
PY_EXTRACTOR_URL=http://py-extractor:8090
PY_EXTRACTOR_TIMEOUT_SECONDS=60
PY_EXTRACTOR_MEM_LIMIT=512m
# Shared whole-MiB hard ceiling for web proxy, backend and local extractor. The
# Admin single-file policy may select a smaller value but cannot exceed it.
PY_EXTRACTOR_MAX_UPLOAD_BYTES=26214400
PY_EXTRACTOR_MAX_OUTPUT_BYTES=5242880
MINERU_UPLOAD_TIMEOUT_SECONDS=300

# If frontend and API use different public origins, add exact frontend origins:
# CORS_EXTRA_ORIGINS=https://chat.example.com
# Same-origin deployments through a shared reverse proxy can usually leave this empty.
CORS_EXTRA_ORIGINS=
# The bundled web container is a trusted reverse proxy and overwrites forwarded
# headers. Set false if backend traffic can bypass that trusted proxy.
TRUST_PROXY_HEADERS=true

# Model channels, API keys, search providers, and crawler services are
# configured in the admin web UI and persisted in PostgreSQL. They are not
# read from .env.docker at runtime.

# ---------------------------------------------------------------------------
# Eino summarization thresholds
# ---------------------------------------------------------------------------
COMPRESSION_MAX_TOKENS=32000
